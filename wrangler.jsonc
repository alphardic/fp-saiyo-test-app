{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "custom-worker.js",
  "name": "fp-saiyo-test-app",
  "compatibility_date": "2026-06-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 毎時0分に、お知らせメールの定期処理を呼ぶ(25日以降の下書き作成・催促・1日朝9時の配信は、呼ばれた側が日時で判断する)
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "SUPABASE_URL": "https://vniwiybntjdbfpmumpvn.supabase.co",
    // 全社員向けお知らせメールの送信元。Resend で alpha-fp.com のドメイン認証が済むまでは送れない
    "NEWSLETTER_FROM": "アルファグループの知識を高めるAIくん <no-reply@alpha-fp.com>"
  }
}
